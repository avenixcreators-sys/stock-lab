# StockLab frontend configuration (Vite exposes only VITE_-prefixed vars)
# Create a real .env file from this template with values from
# Supabase Dashboard > Project Settings > API.
#
# NOTE: these are the PUBLIC web-app config values. They are not secrets and
# may be embedded in the client bundle.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
