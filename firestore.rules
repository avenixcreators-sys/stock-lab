rules_version = '2';
service cloud.firestore {
// StockLab Firestore Security Rules
//
// Educational stock-market simulator: owners may read and write all of their
// own per-user data under users/{uid}/**. All money and trades are virtual;
// a user can only modify their own account.

match /databases/{database}/documents {
  // Per-user data. Owner (the Firebase Auth user) may read only their own data.
  match /users/{uid}/{document=**} {
    allow read, write: if request.auth != null && request.auth.uid == uid;
  }

  // Explicitly deny writes everywhere else (default). Shown for clarity.
  match /{document=**} {
    allow read, write: if false;
  }
}
}
