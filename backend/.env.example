# StockLab backend configuration
# Copy the values below into your real .env file (never commit real secrets).

PORT=3001
FRONTEND_URL=http://localhost:5173

# --- Firebase Admin (required for sign-in + Firestore) ---
# SERVER-ONLY service-account credentials from Firebase Console >
# Project Settings > Service accounts > Generate new private key.
# Provide the private key JSON in ONE of two ways:

# Option A (recommended): paste the whole service-account JSON, base64-encoded.
#   Generate: node -e "console.log(require('fs').readFileSync('serviceAccountKey.json','base64'))"
FIREBASE_SERVICE_ACCOUNT_B64=

# Option B: individual service-account fields.
#FIREBASE_PROJECT_ID=
#FIREBASE_CLIENT_EMAIL=
#FIREBASE_PRIVATE_KEY=

# --- AI Teacher (Groq) ---
# SERVER-ONLY API key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the Groq model used by the AI Teacher.
#AI_TEACHER_MODEL=llama-3.3-70b-versatile

# --- Market data provider (Alpha Vantage) ---
# SERVER-ONLY, never expose in the frontend.
# Free API key from https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Optional: base URL override (for proxies/testing). Defaults to the official endpoint.
#ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

