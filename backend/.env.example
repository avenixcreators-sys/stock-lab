# StockLab backend configuration
# Copy the values below into your real .env file (never commit real secrets).

PORT=3001
FRONTEND_URL=http://localhost:5173

# --- Supabase Authentication (required for sign-in) ---
# URL and keys from Supabase Dashboard > Project Settings > API.
SUPABASE_URL=

# SERVER-ONLY secret key. NEVER expose this in the frontend or commit it.
# Used by the backend to verify access-token JWTs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Market data provider (Alpha Vantage) ---
# SERVER-ONLY, never expose in the frontend.
# Free API key from https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Optional: base URL override (for proxies/testing). Defaults to the official endpoint.
#ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

